{
  "name": "rift-codex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Справочники по играм на общем движке: packages/engine — движок, apps/* — сайты игр",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rift/lol",
    "build": "npm run build -w @rift/lol",
    "start": "npm run start -w @rift/lol",
    "check": "npm run check --workspaces --if-present",
    "update-data": "npm run update-data -w @rift/lol",
    "check-articles": "npm run check-articles -w @rift/lol",
    "dev:genshin": "npm run dev -w @rift/genshin",
    "build:genshin": "npm run build -w @rift/genshin",
    "update-data:genshin": "npm run update-data -w @rift/genshin"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9"
  }
}
